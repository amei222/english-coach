{
  "name": "english-coach-build",
  "private": true,
  "description": "Bundles the Claude adapter (official @anthropic-ai/sdk) into ../vendor/claude.js for the static site",
  "scripts": {
    "check": "tsc --noEmit -p .",
    "build": "npm run check && esbuild src/claude.ts --bundle --format=iife --global-name=ClaudeAdapter --footer:js=\"globalThis.ClaudeAdapter=ClaudeAdapter;\" --minify --target=es2020 --outfile=../vendor/claude.js",
    "test": "node test/e2e.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  }
}
